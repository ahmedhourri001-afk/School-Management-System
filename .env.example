# Variables lues par docker-compose.yml (développement local uniquement).
# Copier vers .env (ignoré par Git) puis remplacer les CHANGE_ME.
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=sms_db
MYSQL_USER=sms_user
MYSQL_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_FACULTY_PASSWORD=CHANGE_ME
SEED_STUDENT_PASSWORD=CHANGE_ME
