# Copier vers .env (ignoré par Git) et remplacer les CHANGE_ME. Ne jamais committer de vraies valeurs.

# Database Credentials
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/sms_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=sms_user
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# Security
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_EXPIRATION=86400000

# Comptes de démonstration (créés au premier démarrage)
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_FACULTY_PASSWORD=CHANGE_ME
SEED_STUDENT_PASSWORD=CHANGE_ME

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
